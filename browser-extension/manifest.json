{
  "manifest_version": 3,
  "key": "",
  "name": "见外知识库助手",
  "version": "1.3.2",
  "description": "见外知识库浏览器插件，支持动态网页与文档集采集、侧边栏问答和 Markdown 笔记",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "见外知识库助手"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["collection.js", "extractors.js", "defuddle.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "scripting",
    "contextMenus",
    "tabs",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "open-sidepanel": {
      "description": "打开侧边栏"
    },
    "quick-ask": {
      "description": "快速提问"
    },
    "select-clip": {
      "description": "选择剪藏"
    },
    "quick-note": {
      "description": "快速笔记"
    },
    "smart-clip": {
      "description": "智能剪藏"
    }
  }
}
